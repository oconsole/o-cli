{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "odoo",
  "plugin": [
    "./plugins/odoo-env.ts",
    "opencode-anthropic-login-via-cli@latest"
  ],
  "mcp": {
    "odoo": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--python",
        "3.11",
        "--script",
        "./vendor/odoo-mcp-server/odoo_mcp_server.py"
      ],
      "enabled": true,
      "timeout": 15000
    }
  },
  "skills": {
    "paths": [
      "./vendor/odoo-skills"
    ]
  }
}
